---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/photos/*.jpg", { eager: true });

interface Props {
  id: string;
  alt: string;
  sizes?: string;
  class?: string;
  position?: string;
  priority?: boolean;
  widths?: number[];
}
const { id, alt, sizes = "100vw", class: cls, position, priority = false, widths = [480, 800, 1200, 1600, 2000, 2560] } = Astro.props;
const src = files[`/src/assets/photos/${id}.jpg`]?.default;
if (!src) throw new Error(`Photo not found: ${id}. Add a JPEG named ${id}.jpg to src/assets/photos/.`);
const usable = widths.filter((w) => w <= src.width);
if (!usable.includes(src.width) && src.width < 2560) usable.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={usable}
  sizes={sizes}
  formats={["avif", "webp"]}
  fallbackFormat="jpg"
  quality={72}
  class={cls}
  style={position ? `object-position:${position}` : undefined}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding={priority ? "sync" : "async"}
/>
