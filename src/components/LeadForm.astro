---
// "Say hello" form: posts a consented inquiry straight into the dedicated
// jaysueno Supabase project (anon key + insert-only RLS). A Database Webhook then
// fires the lead-notify Edge Function (Resend: alert Jay + autoresponder).
//
// Degrades gracefully: until site.config's supabase.url/anonKey hold real values (not the
// YOUR-... placeholders), the form still validates, sends nothing, and points the visitor at
// email instead of failing silently.
import { siteConfig } from "../../site.config";
import { identity } from "../data/identity";
const sb = siteConfig.supabase;
const isSet = (v: string) => Boolean(v) && !v.includes("YOUR-");
const configured = isSet(sb.url) && isSet(sb.anonKey);
// Optional: preselect the topic, e.g. "AI Operations Audit" on /work-with-me/.
const { topic = "" } = Astro.props;
const topics = ["Starting a business", "AI agents", "AI Operations Audit", "Getting sober", "Surf", "Consulting", "Speaking", "General"];
---

<form id="lead-form" class="lead-form" aria-labelledby="lead-form-h" novalidate>
  <h3 id="lead-form-h" class="sr-only">Send a message</h3>
  <!-- honeypot: bots fill this; humans never see it -->
  <input class="hp" type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="lf-row">
    <div class="lf-field">
      <label for="lf-name">Name</label>
      <input id="lf-name" name="name" type="text" placeholder="Your name" autocomplete="name" />
    </div>
    <div class="lf-field">
      <label for="lf-email">Email</label>
      <input id="lf-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" />
    </div>
  </div>

  <div class="lf-field">
    <label for="lf-type">What's this about?</label>
    <select id="lf-type" name="inquiry_type">
      <option value="" disabled selected={!topic}>Choose one…</option>
      {topics.map((t) => <option selected={t === topic}>{t}</option>)}
    </select>
  </div>

  <div class="lf-field">
    <label for="lf-msg">Message</label>
    <textarea id="lf-msg" name="message" rows="3" placeholder="Where are you stuck?"></textarea>
  </div>

  <div class="lf-consent">
    <input id="lf-consent" name="consent" type="checkbox" />
    <label for="lf-consent">I agree to be contacted about my message. No list, no spam, just a reply.</label>
  </div>

  <button type="submit" class="lf-submit">Send it <span aria-hidden="true">→</span></button>
  <p id="lf-msg-status" class="lf-status" role="status" aria-live="polite" hidden></p>
</form>

<script define:vars={{ SB_URL: configured ? sb.url : "", SB_KEY: configured ? sb.anonKey : "", SB_TABLE: sb.leadsTable, CONTACT: identity.email }}>
  (function () {
    var form = document.getElementById("lead-form");
    if (!form) return;
    var el = form.elements;
    var msg = document.getElementById("lf-msg-status");
    var btn = form.querySelector(".lf-submit");
    var configured = !!(SB_URL && SB_KEY);

    function show(kind, text) {
      msg.textContent = text;
      msg.className = "lf-status " + (kind === "ok" ? "is-ok" : "is-err");
      msg.hidden = false;
    }
    function emailOk(v) { return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v); }
    function val(n) { return el[n] && el[n].value ? el[n].value.trim() : ""; }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (el["company_website"] && el["company_website"].value) return; // honeypot

      var name = val("name"), email = val("email");
      var consent = el["consent"] && el["consent"].checked;
      if (name.length < 2) { show("err", "Please enter your name."); return; }
      if (!emailOk(email)) { show("err", "Please enter a valid email address."); return; }
      if (!consent) { show("err", "Please tick the box so I can reply to you."); return; }

      // Pre-backend fallback: never fail silently, point them at email.
      if (!configured) {
        show("ok", "Almost there. Email me directly at " + CONTACT + " and I'll reply.");
        return;
      }

      var q = new URLSearchParams(location.search);
      var kept = {};
      try { kept = JSON.parse(sessionStorage.getItem("js_utm") || "{}"); } catch (e2) { kept = {}; }
      function utm(n) { return q.get(n) || kept[n] || null; }
      var payload = {
        name: name, email: email,
        inquiry_type: val("inquiry_type") || null,
        message: val("message") || null,
        consent: true, status: "new",
        source_page: location.pathname,
        utm_source: utm("utm_source"), utm_medium: utm("utm_medium"),
        utm_campaign: utm("utm_campaign"), utm_term: utm("utm_term"),
        utm_content: utm("utm_content"),
        user_agent: (navigator.userAgent || "").slice(0, 300)
      };

      if (btn) { btn.disabled = true; btn.style.opacity = "0.6"; }
      try {
        var res = await fetch(SB_URL + "/rest/v1/" + SB_TABLE, {
          method: "POST",
          headers: {
            "apikey": SB_KEY,
            "Authorization": "Bearer " + SB_KEY,
            "Content-Type": "application/json",
            "Prefer": "return=minimal"
          },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error("HTTP " + res.status);
        form.reset();
        show("ok", "Got it, thank you. I read every one.");
      } catch (err) {
        show("err", "Couldn't send just now. Please try again, or email " + CONTACT + ".");
        if (btn) { btn.disabled = false; btn.style.opacity = ""; }
      }
    });
  })();
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .lead-form { display: grid; gap: var(--s3); max-width: 38rem; }
  .lf-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s3); }
  .lf-field { display: grid; gap: 0.3rem; }
  .lf-field label { font-size: var(--t-kicker); letter-spacing: 0.09em; text-transform: uppercase; font-weight: 600; }
  .lead-form input[type="text"], .lead-form input[type="email"], .lead-form select, .lead-form textarea {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid currentColor; border-radius: 0; padding: 0.55rem 0; font-size: var(--t-body); color: inherit;
  }
  .lead-form select { appearance: none; }
  .lead-form select option { color: #15201F; }
  .lead-form textarea { resize: vertical; }
  .lead-form ::placeholder { color: inherit; opacity: 0.55; }
  .lf-consent { display: flex; gap: 0.6rem; align-items: start; font-size: var(--t-small); line-height: 1.4; }
  .lf-consent input { margin-top: 0.25rem; accent-color: var(--color-accent); }
  .lf-submit { justify-self: start; background: var(--head, var(--color-primary)); color: var(--submit-ink, var(--color-bg)); border: 0; padding: 0.8rem 1.4rem; font-weight: 600; cursor: pointer; transition: background 200ms var(--ease); }
  .lf-submit:hover { background: var(--color-accent); }
  /* The status line follows the band it sits on: dark ink on the light paper, off-white on the
     dark bands. A fixed off-white made "Got it" invisible on paper (found November 7, 2026). */
  .lf-status { font-size: var(--t-small); font-weight: 600; }
  .lf-status.is-ok { color: var(--head, var(--color-primary)); }
  .lf-status.is-err { color: var(--color-accent); }
  :global(.paper) .lf-status.is-err { color: var(--color-accentSecondary); }
  @media (max-width: 560px) { .lf-row { grid-template-columns: 1fr; } }
</style>
